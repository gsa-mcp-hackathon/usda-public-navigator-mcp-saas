{
  "suite_id": "S01",
  "name": "core-bootstrap",
  "objective": "Any client can connect and read the capability map; no private endpoints exposed",
  "depends_on": [],
  "requires_operator": false,
  "stop_on_fail": true,
  "stop_run_on_fail": true,
  "start_conditions": [
    "Core endpoint reachable over HTTPS",
    "MCP initialize succeeds (retry once on cold start)"
  ],
  "stop_conditions": [
    "Any failure stops the whole run: nothing else is meaningful without a working bootstrap"
  ],
  "maps_to": [
    "O-1",
    "C-1",
    "A-4"
  ],
  "tests": [
    {
      "id": "S01-T01",
      "title": "Tool list exposes required Core read and dispatch tools",
      "action": {
        "type": "tools_list"
      },
      "assertions": [
        {
          "path": "tools",
          "op": "contains_all",
          "value": [
            "describe_core_capabilities",
            "read_core_workflow",
            "route_operation",
            "list_cluster_templates",
            "read_cluster_capability",
            "read_cluster_schema",
            "validate_cluster_template",
            "register_cluster_template",
            "activate_cluster_template",
            "bind_cluster_template_operation",
            "register_source_policy_candidate",
            "decide_source_policy_candidate",
            "read_source_policy_state",
            "manage_source_policy_lifecycle",
            "register_program_candidate_for_review",
            "decide_program_candidate_review",
            "publish_program_candidate_to_cluster_inventory",
            "read_program_candidate_publication",
            "manage_program_candidate_publication",
            "list_core_routes",
            "list_registered_tenants",
            "read_tenant_binding",
            "read_source_metadata",
            "validate_tenant_onboarding",
            "register_tenant",
            "activate_tenant",
            "deactivate_tenant",
            "read_profile",
            "preview_profile_refinement",
            "create_profile_resume_claim",
            "resume_profile",
            "revoke_profile_resume_claim",
            "list_evaluation_fixtures",
            "read_evaluation_fixture",
            "write_profile",
            "set_saved_program_interest",
            "get_fleet_operations_report"
          ],
          "label": "current Core tool surface includes the required discovery and profile tools"
        }
      ],
      "gate": true
    },
    {
      "id": "S01-T02",
      "title": "Capability map is available",
      "action": {
        "type": "call",
        "tool": "describe_core_capabilities"
      },
      "assertions": [
        {
          "path": "status",
          "op": "eq",
          "value": "available"
        },
        {
          "path": "bootstrap.first_step",
          "op": "eq",
          "value": "describe_core_capabilities"
        }
      ],
      "gate": true
    },
    {
      "id": "S01-T03",
      "title": "Private endpoints are not exposed",
      "action": {
        "type": "call",
        "tool": "describe_core_capabilities"
      },
      "assertions": [
        {
          "path": "endpoint_urls_exposed",
          "op": "eq",
          "value": false
        }
      ],
      "gate": true
    },
    {
      "id": "S01-T04",
      "title": "Route, template and tenant registries are available",
      "action": {
        "type": "call",
        "tool": "describe_core_capabilities"
      },
      "assertions": [
        {
          "path": "route_registry.status",
          "op": "eq",
          "value": "available"
        },
        {
          "path": "cluster_registry.status",
          "op": "eq",
          "value": "available"
        },
        {
          "path": "tenant_registry.status",
          "op": "eq",
          "value": "available"
        }
      ],
      "gate": true
    },
    {
      "id": "S01-T05",
      "title": "Operator and client workflows are published",
      "action": {
        "type": "call",
        "tool": "describe_core_capabilities"
      },
      "assertions": [
        {
          "path": "bootstrap.operator_workflows",
          "op": "contains_all",
          "value": [
            "pattern_template_definition",
            "tenant_onboarding_interview",
            "program_candidate_registration"
          ]
        },
        {
          "path": "bootstrap.client_workflows",
          "op": "contains_all",
          "value": [
            "profile_capture",
            "navigator_discovery_then_question",
            "progressive_program_discovery"
          ]
        }
      ],
      "gate": true
    },
    {
      "id": "S01-T06",
      "title": "Progressive discovery workflow resolves end-user path without required profile",
      "action": {
        "type": "call",
        "tool": "read_core_workflow",
        "args": {
          "workflow_id": "progressive_program_discovery"
        }
      },
      "assertions": [
        {
          "path": "workflow.workflow_version",
          "op": "exists"
        },
        {
          "path": "workflow.starting_inputs.profile_required",
          "op": "eq",
          "value": false
        },
        {
          "path": "workflow.operations.search_shared_inventory.read_only",
          "op": "eq",
          "value": true
        },
        {
          "path": "workflow.operations.search_external_leads.profile_access_required",
          "op": "eq",
          "value": false
        }
      ],
      "gate": true
    }
  ],
  "all_tests_gate": false,
  "pass_rule": "Suite PASS = all tests pass. PASS_WITH_DEFECTS = only non-gate tests failed (dependent suites still run). FAIL = a gate test failed (dependent suites are BLOCKED)."
}

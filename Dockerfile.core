# Build the pattern-agnostic Core without tenant or cluster implementation files.
FROM ghcr.io/astral-sh/uv:0.12.24@sha256:dc1f306f26ba5ec796d32b4a30053a2f61192514d01c42278c8e5e0e90b11b22 AS uv
FROM python:3.12.16-alpine3.24@sha256:a61cbd76a882645de7f91423329fe43a67eed60d7da24f9e5331414bb3618b20

ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="MCP SaaS Core" \
    org.opencontainers.image.revision=${VCS_REF} \
    org.opencontainers.image.component="artifact.mcp-saas-platform.core"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HOME=/tmp \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app

WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache xz-libs
COPY --from=uv /uv /usr/local/bin/uv
RUN uv pip install --python /usr/local/bin/python --system \
    setuptools==84.0.0 wheel==0.48.0

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache

# The platform persists to PostgreSQL and has no SQLite runtime path. Keep the
# required Python runtime libraries while omitting optional SQLite.
RUN apk add --no-cache xz-libs libbz2 gdbm libffi libnsl libpanelw libtirpc libuuid \
        readline libcrypto3 libssl3 libncursesw && \
    apk del .python-rundeps && \
    python -c "import bz2, ctypes, dbm.gnu, lzma, readline, ssl, uuid"

# Copy only generic route metadata, template and tenant lifecycle, and Core runtime files.
COPY --chmod=644 src/example_server/__init__.py ./example_server/__init__.py
COPY --chmod=644 src/example_server/core_app.py ./example_server/core_app.py
COPY --chmod=644 src/example_server/core_routes.py ./example_server/core_routes.py
COPY --chmod=644 src/example_server/core_templates.py ./example_server/core_templates.py
COPY --chmod=644 src/example_server/core_tenants.py ./example_server/core_tenants.py
COPY --chmod=644 src/example_server/core_telemetry.py ./example_server/core_telemetry.py
COPY --chmod=644 src/example_server/core_tracing.py ./example_server/core_tracing.py
COPY --chmod=644 src/example_server/core_profiles.py ./example_server/core_profiles.py
COPY --chmod=644 src/example_server/core_source_policy.py ./example_server/core_source_policy.py
COPY --chmod=644 src/example_server/profile_refinement.py ./example_server/profile_refinement.py
COPY --chmod=644 src/example_server/persistence_api_client.py ./example_server/persistence_api_client.py
# Keep the package directory searchable by the non-root runtime.
RUN chmod 755 /app/example_server

USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "example_server.core_app"]

                },
                {
                  "criterion_id": "mo-childcare-care-needed-for-qualifying-activity",
                  "attribute": "mo.dese.childcare.care_needed_for_qualifying_activity",
                  "operator": "eq",
                  "value": true,
                  "source_id": "missouri.dese.child-care-subsidy"
                }
              ],
              "core.geography.country_code": "US",
              "core.geography.jurisdiction_level": "state",
              "core.geography.state_code": "MO",
              "eligibility.program.details": [
                {
                  "kind": "application_step",
                  "text": "Check eligibility first with the DESE \"Do I Qualify?\" pre-screening tool at childcare.mo.gov/parent/s/eligibility-checker.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "application_step",
                  "text": "Apply online with \"Apply for Assistance\" at childcare.mo.gov/parent/s/programs, or use the paper \"Application for Child Care Subsidy for Children and Families.\" The page does not say where to mail the paper form.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "application_step",
                  "text": "For help completing the application, call the Missouri Childhood Resource and Referral Call Center at 573-415-8605 to reach a Community Support Specialist.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "form",
                  "text": "Verification forms named on the DESE page, used as the situation requires: MO 500-3563 Employment Verification Form; MO 500-3602 Incapacitated Caregiver Verification; MO 500-3564 Medical Provider Statement of Special Needs for Child Care; MO 500-3565 Self-Employment Income Ledger.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "form",
                  "text": "The page also links an Application Reminder Checklist and an Appointing an Authorized Representative form for when someone else applies for you.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "required_document",
                  "text": "The page does not list a required-document checklist; it names verification forms (employment, self-employment income, incapacitated caregiver, child special needs). Confirm which apply to your household with the Call Center at 573-415-8605. This is preparation guidance, not a verified mandatory list.",
                  "source_id": "missouri.dese.child-care-subsidy"
                },
                {
                  "kind": "deadline",
                  "text": "The page states no application deadline or processing time. After enrollment, certain changes must be reported within 10 calendar days; this is a reporting duty, not an application deadline.",
                  "source_id": "missouri.dese.child-care-subsidy"
                }
              ]
            },

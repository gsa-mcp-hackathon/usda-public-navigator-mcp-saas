                  "requirement_id": "farm-operation-years",
                  "statement": "A beginning farmer has not operated a farm or ranch for more than 10 years.",
                  "mapping_status": "mapped",
                  "requirement_type": "eligibility",
                  "concept_id": "eligibility.fsa.beginning_farmer.years_operated",
                  "attribute": "core.farm_business.years_farming",

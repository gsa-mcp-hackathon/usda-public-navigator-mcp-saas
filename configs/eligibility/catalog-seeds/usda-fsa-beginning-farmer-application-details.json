                },
                {
                  "requirement_id": "county-farm-ownership-limit",
                  "statement": "A beginning farmer does not own a farm or ranch greater than 30 percent of the average size farm in the county, using the most current Census of Agriculture when the loan application is submitted.",
                  "mapping_status": "not_mapped",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "requirement_id": "substantial-participation",
                  "statement": "A beginning farmer substantially participates in the operation.",

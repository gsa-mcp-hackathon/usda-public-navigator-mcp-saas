                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "requirement_id": "county-selection-rule",
                  "statement": "When a farm crosses county lines, FSA uses the applicant's residence county; if the residence is not on the farm, it uses the county containing the largest portion of the farm.",
                  "mapping_status": "context_only",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "requirement_id": "acreage-exception",
                  "statement": "FSA says the farm-acreage limitation does not apply to a member of a historically underserved group or a woman farmer.",
                  "mapping_status": "not_mapped",
                  "source_id": "usda.fsa.beginning-farmers"
                }
              ],
              "eligibility.program.details": [
                {
                  "kind": "application_step",
                  "text": "Submit a loan application to your local FSA office. The FSA Farm Ownership Loans page says detailed enrollment instructions and deadlines are available through the local FSA office; the reviewed pages list no phone number or email, so find your office through FSA.",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "kind": "application_step",
                  "text": "Before applying, FSA's Farm Ownership Loans page points to its Loan Assistance Tool and Farm Loan Quiz for a fuller eligibility check. Applicants must be U.S. citizens or permanent residents, have enough education, training or experience managing a farm, and show they can repay.",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "kind": "application_step",
                  "text": "For the Direct Farm Ownership Down Payment Loan, the applicant makes a cash down payment of at least 5 percent of the purchase price. The loan only partly finances the purchase of a family-size farm (FSA Beginning Farmers and Ranchers page and January 2026 fact sheet).",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "kind": "application_step",
                  "text": "If the applicant is an entity, all members must be related by blood or marriage and all members must be eligible beginning farmers (FSA January 2026 beginning-farmer fact sheet). Beginning farmers must also meet the requirements of the specific loan program they apply for.",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "kind": "required_document",
                  "text": "The Farm Ownership Loans page says the application includes documentation of financial history, a farm business plan and other required information. It does not list form numbers.",
                  "source_id": "usda.fsa.beginning-farmers"
                },
                {
                  "kind": "deadline",
                  "text": "The reviewed FSA pages state no application deadline for beginning-farmer loans; each year FSA sets aside a portion of loan funds for beginning farmers. Confirm dates with the local FSA office.",
                  "source_id": "usda.fsa.beginning-farmers"
                }
              ]

            "canonical_attributes": {
              "eligibility.program.program_id": "md-ohep-meap",
              "eligibility.program.catalog_version": "Maryland OHEP application instructions reviewed 2026-11-23",
              "eligibility.program.data_origin": "public_source",
              "eligibility.program.title": "Maryland Energy Assistance Program (MEAP)",
              "eligibility.program.description": "Maryland OHEP offers year-round home-energy assistance. This record contains application routes and application information from the official page; household eligibility and grant amount are not evaluated.",
              "eligibility.program.details": [
                {
                  "kind": "application_step",
                  "text": "Submit an application online through MarylandBenefits.gov.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "application_step",
                  "text": "For a paper application, use the DHS-FIA-9780 OHEP Application for Energy Assistance. The OHEP page lists local-office drop boxes and a mail-in option; use its Local Home Energy Program Office link to find the office.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "application_step",
                  "text": "For a telephone application, call 1-800-332-6347. The OHEP page says to mail or email documents after the phone application; clear pictures are accepted.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "application_step",
                  "text": "You may apply in person at a local OHEP office.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "form",
                  "text": "DHS-FIA-9780 — OHEP Application for Energy Assistance. English and Spanish application PDFs are linked from the official application page.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "required_document",
                  "text": "The application page lists these items as information needed with an application: applicant photo ID; proof of residency; Social Security cards for all household members; gross income for the last 30 days; and a utility/heating bill. This is a preparation list, not an eligibility determination.",
                  "source_id": "maryland.ohep"
                },
                {
                  "kind": "deadline",
                  "text": "The OHEP application page labels the program year-round and does not state a fixed application deadline or processing time.",
                  "source_id": "maryland.ohep"
                }
              ],
              "core.geography.country_code": "US",
              "core.geography.jurisdiction_level": "state",
              "core.geography.state_code": "MD"
            },

              ],
              "eligibility.program.details": [
                {
                  "kind": "application_step",
                  "text": "Apply online, print and complete a paper application, or request that a printed application be mailed to you. The page links an English and Spanish application and says Adobe Reader is required for the download.",
                  "source_id": "missouri.dss.snap"
                },
                {
                  "kind": "application_step",
                  "text": "Submit completed application forms online at mydssupload.mo.gov, by mail to Family Support Division, P.O. Box 2700, Jefferson City, MO 65102, or by fax at 573-526-9400.",
                  "source_id": "missouri.dss.snap"
                },
                {
                  "kind": "application_step",
                  "text": "If an interview is required, FSD will call after receiving the application. If you miss the call, visit a local resource center or call 855-823-4908 to complete the interview.",
                  "source_id": "missouri.dss.snap"
                },
                {
                  "kind": "deadline",
                  "text": "Missouri DSS says applicants typically learn whether they are approved within 30 days. FSD says processing an application and supporting documentation can take up to 10 days after receipt; this is a stated processing estimate, not an applicant submission deadline.",
                  "source_id": "missouri.dss.snap"
                },
                {
                  "kind": "deadline",
                  "text": "In some emergency cases, SNAP benefits may be available in seven days or less. The page says to complete Section 2 of the SNAP application or tell FSD at submission if the emergency questions apply; this does not guarantee expedited benefits.",
                  "source_id": "missouri.dss.snap"
                }
              ],
              "core.geography.country_code": "US",

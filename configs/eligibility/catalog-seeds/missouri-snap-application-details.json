              "eligibility.program.title": "Missouri SNAP application and processing guidance",
              "eligibility.program.description": "Source-backed application and submission instructions, interview contingency, and processing timelines for the existing Missouri SNAP listing. Missouri residency and the household SSN condition are mapped; income, resources, and member-specific conviction or fugitive restrictions remain unresolved.",
              "eligibility.program.criteria": [
                {
                  "criterion_id": "residency-missouri",

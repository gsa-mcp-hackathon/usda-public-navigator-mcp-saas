    "decided_by": "operator, 2026-10-26 23:17 ET, confirming positions already on record",
    "rules": [
      {
        "id": "A1-domain-class",
        "rule": "Any host under the .gov or .edu TLD is admitted by class. Implemented as policy_rule {type: tld, value: gov|edu}; per-record host_suffix values are retrieval/search scoping only, not admission.",
        "note": ".us is NOT in A1 (open registration). Legacy state hosts such as mda.state.md.us need A2."
      },
      {
        "id": "A2-role-evidence",
        "rule": "Other hosts are admitted when the organization holds a documented role in a government, institutional, or commercial lending/program-support chain (administers, funds, co-funds, lends, or partners on a program). Record the role and the evidence for it; evidence may come from any credible source that documents the role. A host is never admitted merely for its TLD."
      },
      {
        "id": "A3-fiscal-conditional",
        "rule": "Fiscal/transparency portals are admitted in one of two separate roles: (a) program_lead — the portal leads to a program whose requirements applicants must meet; (b) program_status — funding availability, appropriation lapses, or restrictions that pause applications or payments (e.g. SNAP funding lapse). A status signal annotates program results; it is never program coverage or eligibility criteria."
      }
    ]
  },

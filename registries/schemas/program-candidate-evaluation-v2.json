{
  "registry_id": "eligibility-program-candidate-evaluation-v2-schema",
  "schema_version": "program-candidate-evaluation-v2",
  "namespaces": {
    "candidate": "Request-scoped deterministic comparison",
    "evidence": "Per-clause source-backed comparison outcomes",
    "effects": "Explicit no-persistence result boundary"
  },
  "dimensions": {
    "candidate.result": "Mapped outcomes plus unresolved source clauses",
    "evidence.criteria": "Cited met, unmet, unknown, or not-applicable rule outcomes",
    "effects.request_scope": "No catalog or active-rule mutation"
  },
  "attributes": {
    "candidate.criteria_package_id": {
      "dimension_id": "candidate.result",
      "type": "string"
    },
    "candidate.criteria_status": {
      "dimension_id": "candidate.result",
      "type": "string",
      "allowed_values": [
        "mapped_for_candidate",
        "partial",
        "unmapped"
      ]
    },
    "candidate.criteria_evidence": {
      "dimension_id": "evidence.criteria",
      "type": "array"
    },
    "candidate.unresolved_requirements": {
      "dimension_id": "evidence.criteria",
      "type": "array"
    },
    "candidate.mapped_rule_match_fraction": {
      "dimension_id": "candidate.result",
      "type": "number",
      "description": "Fraction of evaluable mapped rule units marked met; not an eligibility probability."
    },
    "candidate.coverage": {
      "dimension_id": "candidate.result",
      "type": "object"
    },
    "candidate.source_references": {
      "dimension_id": "candidate.result",
      "type": "array"
    },
    "candidate.source_limitations": {
      "dimension_id": "candidate.result",
      "type": "array"
    },
    "candidate.next_step": {
      "dimension_id": "candidate.result",
      "type": "object",
      "description": "Typed client workflow handoff when criteria_mapping_required; includes workflow_id, program_id, and canonical source IDs."
    },
    "candidate.source_validation": {
      "dimension_id": "candidate.result",
      "type": "object",
      "description": "Caller-supplied lineage consistency is checked; Core does not independently fetch the source."
    },
    "effects.request_scoped": {
      "dimension_id": "effects.request_scope",
      "type": "boolean",
      "const": true
    },
    "effects.persistence_performed": {
      "dimension_id": "effects.request_scope",
      "type": "boolean",
      "const": false
    },
    "effects.rules_activated": {
      "dimension_id": "effects.request_scope",
      "type": "boolean",
      "const": false
    },
    "effects.official_eligibility_determination": {
      "dimension_id": "effects.request_scope",
      "type": "boolean",
      "const": false
    }
  },
  "relationships": {
    "evidence.criteria.cites_source": {
      "source_dimension": "evidence.criteria",
      "target_dimension": "candidate.result",
      "cardinality": "many_to_many"
    }
  }
}

    },
    "core.farm_business.resource_concerns": {
      "dimension_id": "core.farm_business",
      "type": "array"
    },
    "core.farm_business.current_practices": {
      "dimension_id": "core.farm_business",
      "type": "array"
    },
    "core.farm_business.farm_type": {
      "dimension_id": "core.farm_business",
      "type": "string"
    },
    "core.farm_business.crop_year": {
      "dimension_id": "core.farm_business",
      "type": "integer"
    },
    "core.farm_business.coverage_type": {
      "dimension_id": "core.farm_business",
      "type": "string"
    },
    "core.benefits.medicaid_full_benefit": {
      "dimension_id": "core.benefits",
      "type": "boolean"
    },
    "core.benefits.medicare_savings_program": {
      "dimension_id": "core.benefits",
      "type": "boolean"
    },
    "core.benefits.ssi_recipient": {
      "dimension_id": "core.benefits",
      "type": "boolean"
    },
    "core.farm.acreage_report_filed": {

{
  "registry_id": "eligibility-public-listing-schema",
  "schema_version": "public-listing-v2",
  "namespaces": {
    "core": "Shared geographic context",
    "listing": "Shared, source-backed public listing concepts"
  },
  "dimensions": {
    "listing.public_listing": "A published public program or funding opportunity without inferred eligibility criteria",
    "core.geography": "Geographic scope of the public listing"
  },
  "attributes": {
    "listing.record_kind": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "allowed_values": ["assistance_program"]
    },
    "listing.program_number": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$"
    },
    "listing.title": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.summary": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.agency": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.assistance_type": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.applicant_description": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.beneficiary_description": {
      "dimension_id": "listing.public_listing",
      "type": "string"
    },
    "listing.program_url": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "pattern": "^https://"
    },
    "listing.website_url": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "pattern": "^https://"
    },
    "listing.published_date": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "listing.status": {
      "dimension_id": "listing.public_listing",
      "type": "string",
      "allowed_values": ["unknown"]
    },
    "core.geography.jurisdiction_level": {
      "dimension_id": "core.geography",
      "type": "string",
      "allowed_values": ["federal"]
    },
    "core.geography.country_code": {
      "dimension_id": "core.geography",
      "type": "string",
      "pattern": "^US$"
    }
  },
  "relationships": {}
}

{
  "registry_id": "eligibility-program-schema",
  "schema_version": "eligibility-program-v2",
  "namespaces": {
    "eligibility": "Eligibility template program catalog semantics"
  },
  "dimensions": {
    "eligibility.program": "A public program as defined by the Eligibility template"
  },
  "attributes": {
    "eligibility.program.program_id": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.catalog_version": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.navigator": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.data_origin": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.title": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.description": {"dimension_id": "eligibility.program", "type": "string"},
    "eligibility.program.criteria": {"dimension_id": "eligibility.program", "type": "array"},
    "eligibility.program.published_requirements": {
      "dimension_id": "eligibility.program",
      "type": "array",
      "description": "Source-published statements kept separate from executable criteria. Never use these for met/unmet or eligibility results until reviewed and explicitly mapped.",
      "items": {
        "type": "object",
        "required": ["requirement_id", "statement", "mapping_status", "source_id"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "mapping_status": {"type": "string", "enum": ["not_mapped", "context_only"]},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "additionalProperties": false
      }
    }
  },
  "relationships": {}
}

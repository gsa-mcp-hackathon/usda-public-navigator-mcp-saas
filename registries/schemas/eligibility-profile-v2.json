    "mo.dese.childcare.child_has_special_needs": {
      "dimension_id": "mo.dese.childcare",
      "type": "boolean"
    },
    "mo.dese.childcare.child_receiving_protective_services": {
      "dimension_id": "mo.dese.childcare",
      "type": "boolean"
    },
    "snap.all_members_have_or_applying_ssn": {
      "dimension_id": "snap",
      "type": "boolean"
    },
    "snap.any_member_restricted_by_felony_or_drug_conviction": {

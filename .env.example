# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Use `example` for the starter, `core` for the router, or `tenant` for a
# separately deployed tenant runtime. Configure tenants with synthetic/public data.
MCP_ROLE=example
# Standalone Core reads route and cluster-template registries through the
# Persistence Access API. Template/tenant writes and route telemetry stay disabled
# unless their scoped writer credentials are configured; lifecycle/report tools
# also require the operator credential in the MCP request header.
PERSISTENCE_API_URL=
PERSISTENCE_API_TOKEN_FILE=
TEMPLATE_REGISTRY_WRITE_TOKEN_FILE=
TENANT_REGISTRY_WRITE_TOKEN_FILE=
ROUTE_TELEMETRY_WRITE_TOKEN_FILE=
PROFILE_READ_TOKEN_FILE=
PROFILE_WRITE_TOKEN_FILE=
OPERATOR_TOKEN_FILE=
TENANT_ID=
CLUSTER_ID=
PATTERN_VERSION=
CATALOG_BACKEND=config
# Non-secret, cluster-specific tenant configuration. Eligibility catalogs use
# TENANT_PROGRAMS_JSON; other clusters define their own validated config shape.
CLUSTER_CONFIG_JSON={}
TENANT_PROGRAMS_JSON=[]
TENANT_ENDPOINTS_JSON=[]

# ─── Dataset API Keys ─────────────────────────────────────────────────────────
# Add a variable for each federal API your tools call, and a matching typed
# field in src/example_server/config.py. Never commit the filled-in .env.
#
# EXAMPLE_API_KEY=your_key_here

# Route mapping to the optional LLM mapper component (true) or leave it to the
# calling AI agent (false, the recommended setting for a new install). The mapper
# component needs its own provider endpoint and credentials; without them, set
# this to false. See docs/PROVIDER-NEUTRALITY.md.
MCP_LLM_MAPPER_ENABLED=false
